# Copy to .env and adjust for local development / Docker.
RECIPEBOOK_DATA_DIR=./data
RECIPEBOOK_SECRET_KEY=change-me
# RECIPEBOOK_DATABASE_URL=sqlite:///./data/recipebook.db
# RECIPEBOOK_MEDIA_DIR=./data/media

# Default UI language (en or fi); visitors can override it per browser.
RECIPEBOOK_LANGUAGE=en

# Optional login (off by default). Generate a hash with: python hash_password.py
# RECIPEBOOK_AUTH_ENABLED=true
# RECIPEBOOK_AUTH_USERNAME=admin
# RECIPEBOOK_AUTH_PASSWORD_HASH=pbkdf2_sha256$260000$...
# Or a plaintext password that is hashed at startup (less safe):
# RECIPEBOOK_AUTH_PASSWORD=changeme
